{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in Cloudflare or Workers Builds fails.
  "name": "cube-trainer",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "cube.nathanwei.org", "custom_domain": true }]
}
